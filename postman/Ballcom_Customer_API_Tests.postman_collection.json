{
  "info": {
    "name": "Ballcom Customer API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "customer_url", "value": "https://localhost:7108" },
    { "key": "customerId", "value": "" },
    { "key": "customerPhone", "value": "+31612345678" },
    { "key": "unknownCustomerId", "value": "00000000-0000-0000-0000-000000000000" }
  ],
  "item": [
    {
      "name": "Customer",
      "item": [
        {
          "name": "00 Health check",
          "request": {
            "method": "GET",
            "url": "{{customer_url}}/health"
          }
        },
        {
          "name": "01 Create Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('customerId', json.customerId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Emre\",\n  \"lastName\": \"Test\",\n  \"companyName\": \"Ballcom Test BV\",\n  \"phoneNumber\": \"{{customerPhone}}\",\n  \"address\": \"Teststraat 1, Tilburg\",\n  \"identityUserId\": null\n}"
            },
            "url": "{{customer_url}}/api/customers"
          }
        },
        {
          "name": "02 Get Customers",
          "request": {
            "method": "GET",
            "url": "{{customer_url}}/api/customers?pageNumber=1&pageSize=50"
          }
        },
        {
          "name": "03 Get Customer By Id",
          "request": {
            "method": "GET",
            "url": "{{customer_url}}/api/customers/{{customerId}}"
          }
        },
        {
          "name": "04 Get Customer By Phone",
          "request": {
            "method": "GET",
            "url": "{{customer_url}}/api/customers/phone/{{customerPhone}}"
          }
        },
        {
          "name": "05 Update Customer",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Emre\",\n  \"lastName\": \"Updated\",\n  \"companyName\": \"Ballcom Updated BV\",\n  \"phoneNumber\": \"{{customerPhone}}\",\n  \"address\": \"Updatedstraat 2, Tilburg\",\n  \"identityUserId\": null\n}"
            },
            "url": "{{customer_url}}/api/customers/{{customerId}}"
          }
        },
        {
          "name": "06 Get Customer After Update",
          "request": {
            "method": "GET",
            "url": "{{customer_url}}/api/customers/{{customerId}}"
          }
        },
        {
          "name": "07 Upsert Imported Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Imported\",\n  \"lastName\": \"Customer\",\n  \"companyName\": \"CSV BV\",\n  \"phoneNumber\": \"+31687654321\",\n  \"address\": \"CSV Straat 3, Breda\",\n  \"identityUserId\": null\n}"
            },
            "url": "{{customer_url}}/api/customers/imported"
          }
        },
        {
          "name": "08 Unknown Customer Returns 404",
          "request": {
            "method": "GET",
            "url": "{{customer_url}}/api/customers/{{unknownCustomerId}}"
          }
        }
      ]
    }
  ]
}
